{'author': 'Christian Wirtz',
 'description': 'Home Assistant special agent for Checkmk 2.5.0+. Reads sensor '
                'states via the REST API and device/entity/area metadata via '
                'the WebSocket API, groups entities by Home Assistant '
                'area/room, emits readable piggyback hosts (ha-<area>) and '
                'creates one Checkmk service per entity plus one "Home '
                'Assistant API" source service. Supports domain filtering, '
                'include/exclude regex, stale-data warnings, and safety '
                'limits on the number of generated hosts and entities. Pure '
                'Python stdlib WebSocket client - no extra dependency beyond '
                'requests, which already ships with the Checkmk agent stack.',
 'download_url': 'https://github.com/Gulaschcowboy/checkmk_extensions',
 'files': {'cmk_addons_plugins': ['homeassistant/agent_based/homeassistant.py',
                                  'homeassistant/agent_based/homeassistant_source.py',
                                  'homeassistant/libexec/agent_homeassistant',
                                  'homeassistant/rulesets/special_agent.py',
                                  'homeassistant/server_side_calls/special_agent.py',
                                  'homeassistant/checkman/homeassistant']},
 'name': 'homeassistant',
 'title': 'Home Assistant',
 'version': '0.2.4',
 'version.min_required': '2.5.0',
 'version.packaged': '2.5.0',
 'version.usable_until': None}
