{'author': 'Alex Wilms',
 'description': 'Special agent for LinOTP two-factor authentication servers, '
                'via LinOTP\'s own JSONRPC admin/monitoring API '
                '(/monitoring/*, /system/*). Authenticates with a (read-only) '
                'LinOTP admin user/password and polls token counts, '
                'per-resolver user counts, storage encryption status, config '
                'sync status, and license/support status. Creates one '
                '"LinOTP Tokens <realm>" and "LinOTP Resolver <realm> / '
                '<resolver>" service per realm/resolver directly on the '
                'queried host (no piggyback hosts), plus "LinOTP Source" '
                '(own run health), "LinOTP License", "LinOTP Storage '
                'Encryption" and "LinOTP Config Sync" services. Upper/lower '
                'levels are configurable for token counts and resolver user '
                'counts (off by default).\n'
                'Endpoint choice and JSON field names were validated against '
                'a production LinOTP 3.2.6 instance before implementation.',
 'download_url': 'https://github.com/Gulaschcowboy/checkmk_extensions',
 'files': {'cmk_addons_plugins': ['linotp_rest/agent_based/linotp_rest_config.py',
                                  'linotp_rest/agent_based/linotp_rest_license.py',
                                  'linotp_rest/agent_based/linotp_rest_resolvers.py',
                                  'linotp_rest/agent_based/linotp_rest_source.py',
                                  'linotp_rest/agent_based/linotp_rest_storage_encryption.py',
                                  'linotp_rest/agent_based/linotp_rest_tokens.py',
                                  'linotp_rest/checkman/linotp_rest_config',
                                  'linotp_rest/checkman/linotp_rest_license',
                                  'linotp_rest/checkman/linotp_rest_resolvers',
                                  'linotp_rest/checkman/linotp_rest_source',
                                  'linotp_rest/checkman/linotp_rest_storage_encryption',
                                  'linotp_rest/checkman/linotp_rest_tokens',
                                  'linotp_rest/libexec/agent_linotp_rest',
                                  'linotp_rest/rulesets/linotp_rest.py',
                                  'linotp_rest/rulesets/linotp_rest_params.py',
                                  'linotp_rest/server_side_calls/linotp_rest.py']},
 'name': 'linotp_rest',
 'title': 'LinOTP (via REST API)',
 'version': '1.0.0',
 'version.min_required': '2.5.0',
 'version.packaged': '2.5.0',
 'version.usable_until': None}
