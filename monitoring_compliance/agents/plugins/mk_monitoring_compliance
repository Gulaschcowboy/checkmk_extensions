#!/bin/bash
# Optional Checkmk agent plug-in (Linux) for "Monitoring Compliance".
#
# Emits a clean JSON capability section with running processes, installed
# packages and running systemd service units. Preferred by the check plug-in;
# if missing, the check falls back to the standard sections ps / lnx_packages /
# systemd_units.
#
# Install: copy to /usr/lib/check_mk_agent/plugins/ (executable) or bake it.

echo '<<<monitoring_compliance_inventory:sep(0)>>>'

if command -v python3 >/dev/null 2>&1; then
    python3 - <<'PY' 2>/dev/null
import json
import os
import subprocess


def run(cmd, timeout):
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""


procs = set()
for line in run(["ps", "-eo", "comm="], 30).splitlines():
    line = line.strip()
    if line:
        procs.add(os.path.basename(line))

units = set()
out = run(["systemctl", "list-units", "--type=service", "--state=running",
           "--no-legend", "--plain", "--no-pager"], 30)
for line in out.splitlines():
    parts = line.split()
    if parts and parts[0].endswith(".service"):
        units.add(parts[0])

pkgs = set()
for line in run(["dpkg-query", "-W", "-f=${Package}\n"], 60).splitlines():
    if line.strip():
        pkgs.add(line.strip())
if not pkgs:
    for line in run(["rpm", "-qa", "--qf", "%{NAME}\n"], 60).splitlines():
        if line.strip():
            pkgs.add(line.strip())

print(json.dumps({
    "os": "linux",
    "processes": sorted(procs),
    "systemd_units": sorted(units),
    "packages": sorted(pkgs),
}, ensure_ascii=False))
PY
else
    procs=$(ps -eo comm= 2>/dev/null | sed 's:.*/::' | sort -u \
            | sed 's/"/\\"/g' | awk 'NR==1{printf "\"%s\"",$0; next}{printf ",\"%s\"",$0}')
    printf '{"os":"linux","processes":[%s],"systemd_units":[],"packages":[]}\n' "$procs"
fi
