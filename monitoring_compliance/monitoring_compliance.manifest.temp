{'author': 'Christian Wirtz',
 'description': 'Checkmk Monitoring Compliance.\n'
                '\n'
                'Detects installed and/or running services on a host that are '
                'not yet monitored, even though a suitable Checkmk plug-in is '
                "available on the server. The result is a 'Checkmk Monitoring "
                "Compliance' service with WARN/CRIT logic and a compliance "
                'metric (compliance_percent).\n'
                '\n'
                'Detection is capability-based: every source (processes, '
                'systemd units, Windows services, host labels, HW/SW inventory '
                'packages) contributes typed capabilities that are correlated '
                'to available plug-ins. Capabilities are written to a '
                'persistent, deduplicated capability database. Additional '
                'services report database statistics and a read-only known '
                'catalog. Optional agent plug-ins (Linux shell, Windows '
                'PowerShell) provide clean capability data and can be deployed '
                'via the Agent Bakery (commercial editions).',
 'download_url': 'https://github.com/Gulaschcowboy/checkmk_extensions',
 'files': {'agents': ['plugins/mk_monitoring_compliance',
                      'windows/plugins/mk_monitoring_compliance.ps1'],
           'cmk_addons_plugins': ['monitoring_compliance/agent_based/monitoring_compliance.py',
                                  'monitoring_compliance/agent_based/capability_db.py',
                                  'monitoring_compliance/agent_based/known_catalog.py',
                                  'monitoring_compliance/server_side_calls/special_agent.py',
                                  'monitoring_compliance/rulesets/special_agent.py',
                                  'monitoring_compliance/rulesets/check_parameters.py',
                                  'monitoring_compliance/rulesets/check_parameters_capdb.py',
                                  'monitoring_compliance/rulesets/agent_bakery.py',
                                  'monitoring_compliance/graphing/metrics.py',
                                  'monitoring_compliance/checkman/monitoring_compliance',
                                  'monitoring_compliance/checkman/monitoring_compliance_capdb',
                                  'monitoring_compliance/checkman/monitoring_compliance_known_catalog',
                                  'monitoring_compliance/libexec/agent_monitoring_compliance'],
           'lib': ['python3/cmk/base/cee/plugins/bakery/monitoring_compliance.py']},
 'name': 'monitoring_compliance',
 'title': 'Checkmk Monitoring Compliance',
 'version': '1.5.19',
 'version.min_required': '2.3.0p1',
 'version.packaged': 'manual-build',
 'version.usable_until': None}
