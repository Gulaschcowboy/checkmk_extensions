{'author': 'Alex Wilms',
 'description': 'Special agent for OPNsense firewalls via the REST API. '
                'Monitors firmware/update status, all services (one service '
                'per OPNsense service, auto-discovered), system status, '
                'uptime, load, memory, swap and filesystem usage. '
                'Configurable HTTPS port (default 8443) and optional TLS '
                'certificate check bypass for self-signed certificates.',
 'download_url': 'https://github.com/adminguru/checkmk-opnsense',
