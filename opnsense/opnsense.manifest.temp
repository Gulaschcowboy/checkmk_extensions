                                  'opnsense/agent_based/opnsense_system.py',
                                  'opnsense/agent_based/opnsense_disk.py',
                                  'opnsense/rulesets/opnsense.py',
                                  'opnsense/rulesets/opnsense_params.py',
                                  'opnsense/server_side_calls/opnsense.py',
                                  'opnsense/graphing/opnsense.py',
                                  'opnsense/checkman/opnsense_firmware',
                                  'opnsense/checkman/opnsense_services',
                                  'opnsense/checkman/opnsense_system',
                                  'opnsense/checkman/opnsense_memory',
