{'author': 'Alex Wilms',
 'description': 'Special agent for Citrix Virtual Apps and Desktops (CVAD) '
                'via the on-premises CVAD REST API (Citrix Orchestration '
                'Service, requires CVAD 2212 or newer). Authenticates with '
                'a Citrix admin user/password against the Delivery '
                'Controller and polls /cvad/manage/Machines and '
                '/cvad/manage/Sessions. Emits piggyback data using the '
                'exact same agent sections (citrix_state, citrix_serverload, '
                'citrix_sessions, citrix_hostsystem) as Citrix\'s own '
                'Windows agent plug-in citrix_farm.ps1, so Checkmk\'s '
                'built-in Citrix checks are reused unchanged - this package '
                'ships no custom check plug-ins and therefore does not '
                'collide with Checkmk\'s built-in Citrix monitoring. Useful '
                'when running citrix_farm.ps1 directly on the Delivery '
                'Controller is not desired/possible, since this agent runs '
                'remotely from the Checkmk server over HTTPS. Limitation: '
                'the CVAD REST API has no documented equivalent for '
                'Get-BrokerController, so Citrix Controller licensing/health '
                '(citrix_controller service) is not covered and still '
                'requires citrix_farm.ps1 if needed. Do not run both agents '
                'for the same machines at the same time.',
 'download_url': 'https://github.com/Gulaschcowboy/checkmk_extensions',
 'files': {'cmk_addons_plugins': ['citrix_vad_rest/libexec/agent_citrix_vad_rest',
                                  'citrix_vad_rest/rulesets/citrix_vad_rest.py',
                                  'citrix_vad_rest/server_side_calls/citrix_vad_rest.py']},
 'name': 'citrix_vad_rest',
 'title': 'Citrix Virtual Apps and Desktops (CVAD REST API)',
 'version': '0.1.0',
 'version.min_required': '2.5.0',
 'version.packaged': '2.5.0',
 'version.usable_until': None}
