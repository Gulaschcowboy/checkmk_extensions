{'author': 'Christian Wirtz',
 'description': "Monitors the ZFS Adaptive Replacement Cache (ARC) on a Linux host running "
                "OpenZFS via a local check. Reports ARC size as a percentage of its "
                "configured maximum (c_max) and of total system RAM, the cache hit ratio, "
                "and the memory_throttle_count, going WARN/CRIT on configurable-in-source "
                "thresholds and printing a heuristic zfs_arc_max tuning recommendation. "
                "Ships a companion agent plugin that also emits the raw arcstats kstat "
                "values as a separate <<<zfs_arc_cache>>> section for custom checks.",
 'download_url': 'https://github.com/Gulaschcowboy/checkmk_extensions',
 'files': {'agents': ['custom/zfs_arc/lib/local/zfs_arc.sh',
                      'custom/zfs_arc/lib/plugins/zfs_arc_cache'],
           'cmk_addons_plugins': ['zfs_arc/checkman/zfs_arc']},
 'name': 'zfs_arc',
 'title': 'ZFS ARC cache usage',
 'version': '0.0.3',
 'version.min_required': '2.3.0p1',
 'version.packaged': 'hermes',
 'version.usable_until': None}
