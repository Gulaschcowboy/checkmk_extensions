#!/bin/bash

# https://forum.checkmk.com/t/howto-monitoring-arc-cache-statistics-for-zfs-on-linux/43321
#
# Raw ZFS ARC kstat dump as a Checkmk agent section. There is currently no
# agent_based check plugin in this package that parses <<<zfs_arc_cache>>> —
# the actual monitoring (state/thresholds) is done by the local check
# lib/local/zfs_arc.sh below. This section is kept for anyone who wants to
# build their own check plugin against the raw ARC kstat values.

ARCSTATS="/proc/spl/kstat/zfs/arcstats"

echo '<<<zfs_arc_cache>>>'
if [ -f "$ARCSTATS" ]; then
    sed -e '1,2d' "$ARCSTATS" |
    awk '{printf "%s = %s\n", $1, $3;}'
fi

